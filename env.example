# ===========================================
# AstraStudio — Environment Variables
# ===========================================
# Скопируйте в .env и настройте под окружение:
#   cp env.example .env
# One-liner (install.sh / install.ps1) делает это сам и генерирует секреты.

# ===========================================
# УСТАНОВКА / ОБНОВЛЕНИЯ (one-liner, GHCR)
# ===========================================

# Тег prebuilt-образов GHCR (latest или vX.Y.Z / sha-…)
ASTRA_VERSION=latest
# Self-update из UI (admin → О приложении). One-liner включает автоматически.
ASTRA_UPDATES_ENABLED=false
# Абсолютный путь к каталогу установки НА ХОСТЕ (docker.sock + release.yml)
ASTRA_HOST_ROOT_ON_HOST=
ASTRA_HOST_ROOT=
ASTRA_GITHUB_REPO=NeKonnnn/Astra-Studio
ASTRA_GITHUB_REF=main
ASTRA_PROFILE=full
ASTRA_LLM_VARIANT=cuda

# ===========================================
# ОСНОВНЫЕ НАСТРОЙКИ ПРОЕКТА
# ===========================================

NODE_ENV=production
PYTHON_ENV=production
DEBUG=false
LOG_LEVEL=INFO
DOCKER_ENV=true

# ===========================================
# НАСТРОЙКИ СЕРВИСОВ
# ===========================================

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend (bake в образ; для rebuild задайте REACT_APP_*)
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000

# ===========================================
# JWT / АУТЕНТИФИКАЦИЯ
# ===========================================

# Install-скрипт перезапишет случайными значениями
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=1800
JWT_REFRESH_TOKEN_EXPIRE_SECONDS=604800
AUTH_MAX_ACTIVE_SESSION=5
AUTH_SESSION_TIMEOUT_SECONDS=0

# Mock users (admin/admin123) + локальная регистрация в PostgreSQL
# (POST /api/auth/register), пока LDAP/Keycloak выключены
LDAP_ENABLED=false

# ===========================================
# LDAP / ACTIVE DIRECTORY (опционально)
# ===========================================

# LDAP_ENABLED=true
# LDAP_URL=ldaps://ad.company.local:636
# LDAP_USER_SEARCH_BASE=dc=company,dc=local
# LDAP_SEARCH_FILTER=(sAMAccountName={username})
# LDAP_ADMIN_GROUPS=CN=Astra Admins,OU=Groups,DC=company,DC=local
# LDAP_TIMEOUT=10

# ===========================================
# НАСТРОЙКИ БАЗ ДАННЫХ
# ===========================================

# MongoDB — диалоги
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=astrachat
MONGODB_AUTH_SOURCE=admin
MONGODB_USER=admin
MONGODB_PASSWORD=changeme-mongo

# PostgreSQL + pgvector — RAG
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_DB=astrachat
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme-postgres
EMBEDDING_DIM=1536

# MinIO / SILO — объектное хранилище (S3 API)
# Хост-порты в docker-compose: 9000 (API), 9001 (console)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme-minio
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=astrachat-temp
MINIO_DOCUMENTS_BUCKET_NAME=astrachat-documents
MINIO_MEMORY_RAG_BUCKET_NAME=astrachat-memory-rag
MINIO_SERVICE_ENABLED=true

# ===========================================
# RAG
# ===========================================

SVC_RAG_API_KEY=changeme-svc-rag-key
RAG_SERVICE_ENABLED=true
RAG_MODELS_SERVICE_ENABLED=true
POSTGRESQL_SERVICE_ENABLED=true
RAG_MEMORY_ENABLED=true
RAG_ENTITY_EMBEDDING_MODEL=local/FRIDA
RAG_ENTITY_RERANKING_ENABLED=false
SVC_RAG_SEARCH_READ_TIMEOUT=240

# ===========================================
# FEATURE FLAGS
# ===========================================

# minimal profile: speech/vision = false
STT_SERVICE_ENABLED=true
TTS_SERVICE_ENABLED=true
DIARIZATION_SERVICE_ENABLED=true
AGENTS_SERVICE_ENABLED=true

# ===========================================
# LLM
# ===========================================

USE_LLM_SVC=true
LLM_SVC_TIMEOUT=300
LLM_MODEL_LOAD_TIMEOUT=1800
LLM_INFERENCE_REPLICAS=2
# Eager load + keep-alive (сек; 0 = не выгружать)
LLM_EAGER_LOAD=1
LLM_WARMUP_ON_LOAD=1
LLM_KEEP_ALIVE_SECONDS=0
LLM_MAX_LOADED_MODELS=4
# Пусто = auto (cpu_count-1) или значение из llm-svc/config/config.yml
LLM_N_THREADS=
LLM_N_THREADS_BATCH=
LLM_SERVICE_DISABLE_THINKING=true
LLM_SERVICE_MIN_MAX_TOKENS=1024

# ===========================================
# HUGGING FACE / ЗАГРУЗКА МОДЕЛЕЙ
# ===========================================

HF_TOKEN=
HF_HUB_ENABLE_HF_TRANSFER=1
MODEL_DOWNLOAD_CONNECTIONS=8

# ===========================================
# COMFYUI / OMNIVOICE
# ===========================================

COMFYUI_FORCE_CPU=0
IMAGE_GEN_COMFYUI_URL=http://comfyui:8188
OMNIVOICE_DEVICE=cuda:0
OMNIVOICE_HF_OFFLINE=0

# ===========================================
# MCP WEBSEARCH
# ===========================================

MCP_SERVER_WEBSEARCH_ENABLED=true
MCP_SERVER_WEBSEARCH_TRANSPORT=streamable-http
MCP_SERVER_WEBSEARCH_BASE_PATH=/mcp
MCP_SERVER_WEBSEARCH_HEALTH_PATH=/mcp

# ===========================================
# CORS (опционально)
# ===========================================

# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
# CORS_ALLOW_CREDENTIALS=true

# ===========================================
# ПРИМЕЧАНИЯ
# ===========================================
# 1. Секреты (пароли БД, MinIO, JWT) — через ENV; YAML их не должен перекрывать.
# 2. Для Docker host-имена: mongodb / postgresql / minio (не localhost).
# 3. One-liner генерирует случайные пароли при первом создании .env.
