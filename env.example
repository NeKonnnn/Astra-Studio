# AstraStudio — шаблон окружения (скопируйте в .env)
# cp env.example .env
# One-liner install.sh / install.ps1 делает это автоматически и генерирует секреты.

# Версия prebuilt-образов GHCR (latest или vX.Y.Z)
ASTRA_VERSION=latest

# Режим
NODE_ENV=production
PYTHON_ENV=production
DEBUG=false
LOG_LEVEL=INFO
DOCKER_ENV=true

# Frontend (bake в образ; для rebuild: REACT_APP_*)
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000

# JWT (install-скрипт перезапишет случайными значениями)
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TOKEN_EXPIRE_SECONDS=1800
JWT_REFRESH_TOKEN_EXPIRE_SECONDS=604800
AUTH_MAX_ACTIVE_SESSION=5
AUTH_SESSION_TIMEOUT_SECONDS=0

# Auth: mock users (admin/admin123) пока LDAP/Keycloak выключены
LDAP_ENABLED=false

# MongoDB
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=astrachat
MONGODB_AUTH_SOURCE=admin
MONGODB_USER=admin
MONGODB_PASSWORD=changeme-mongo

# PostgreSQL + pgvector
POSTGRES_HOST=postgresql
POSTGRES_PORT=5432
POSTGRES_DB=astrachat
POSTGRES_USER=admin
POSTGRES_PASSWORD=changeme-postgres

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme-minio
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=astrachat-temp
MINIO_DOCUMENTS_BUCKET_NAME=astrachat-documents
MINIO_MEMORY_RAG_BUCKET_NAME=astrachat-memory-rag
MINIO_SERVICE_ENABLED=true

# RAG
SVC_RAG_API_KEY=changeme-svc-rag-key
RAG_SERVICE_ENABLED=true
RAG_MODELS_SERVICE_ENABLED=true
POSTGRESQL_SERVICE_ENABLED=true
RAG_MEMORY_ENABLED=true
RAG_ENTITY_EMBEDDING_MODEL=local/FRIDA
RAG_ENTITY_RERANKING_ENABLED=false
SVC_RAG_SEARCH_READ_TIMEOUT=240

# Feature flags (minimal profile: speech/vision = false)
STT_SERVICE_ENABLED=true
TTS_SERVICE_ENABLED=true
DIARIZATION_SERVICE_ENABLED=true
AGENTS_SERVICE_ENABLED=true

# LLM
USE_LLM_SVC=true
LLM_SVC_TIMEOUT=300
LLM_MODEL_LOAD_TIMEOUT=1800
LLM_INFERENCE_REPLICAS=2
LLM_SERVICE_DISABLE_THINKING=true
LLM_SERVICE_MIN_MAX_TOKENS=1024

# Hugging Face (gated models: pyannote и т.п.; UI «Загрузка моделей»)
HF_TOKEN=
HF_HUB_ENABLE_HF_TRANSFER=1
MODEL_DOWNLOAD_CONNECTIONS=8

# ComfyUI / OmniVoice
COMFYUI_FORCE_CPU=0
IMAGE_GEN_COMFYUI_URL=http://comfyui:8188
OMNIVOICE_DEVICE=cuda:0
OMNIVOICE_HF_OFFLINE=0

# MCP websearch
MCP_SERVER_WEBSEARCH_ENABLED=true
MCP_SERVER_WEBSEARCH_TRANSPORT=streamable-http
MCP_SERVER_WEBSEARCH_BASE_PATH=/mcp
MCP_SERVER_WEBSEARCH_HEALTH_PATH=/mcp
